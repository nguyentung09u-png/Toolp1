<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Nhà 3D - Hamburger + Sidebar + FAB</title>

  <style>
    * { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }
    body { margin: 0; overflow: hidden; background: #08090b; font-family: 'Inter', system-ui, sans-serif; color: #e6ebf2; }
    canvas { display: block; }

    /* =====================================================
       (1) HAMBURGER — góc trên trái
       ===================================================== */
    .hamburger {
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: rgba(15, 18, 23, 0.85);
      border: 1px solid #242b36;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: background 0.22s, border-color 0.22s, box-shadow 0.22s, opacity 0.25s, transform 0.25s;
      user-select: none;
      z-index: 110;
      backdrop-filter: blur(6px);
      padding: 0;
    }
    .hamburger:hover {
      background: rgba(20, 24, 31, 0.95);
      border-color: #2e3742;
      box-shadow: 0 0 22px -4px rgba(0, 230, 176, 0.5);
    }
    .hamburger:active { transform: scale(0.94); }
    .hamburger.hidden {
      opacity: 0;
      pointer-events: none;
      transform: scale(0.8);
    }
    .hamburger .bars {
      width: 24px;
      height: 17px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .hamburger .bars span {
      display: block;
      height: 2px;
      width: 100%;
      background: #00e6b0;
      border-radius: 2px;
      box-shadow: 0 0 8px rgba(0, 230, 176, 0.6);
    }

    /* =====================================================
       (3) CLOSE BUTTON — trong sidebar
       ===================================================== */
    .close-btn {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: #0f1217;
      border: 1px solid #242b36;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.15s;
      user-select: none;
      flex-shrink: 0;
      padding: 0;
    }
    .close-btn:hover {
      background: #1a1215;
      border-color: #4a2428;
      box-shadow: 0 0 18px -4px rgba(255, 90, 90, 0.45);
    }
    .close-btn:active { transform: scale(0.92); }
    .close-btn .x { position: relative; width: 18px; height: 18px; }
    .close-btn .x span {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100%;
      height: 2px;
      background: #ff5a5a;
      border-radius: 2px;
      box-shadow: 0 0 8px rgba(255, 90, 90, 0.6);
      transition: background 0.2s, box-shadow 0.2s;
    }
    .close-btn .x span:nth-child(1) { transform: translate(-50%, -50%) rotate(45deg); }
    .close-btn .x span:nth-child(2) { transform: translate(-50%, -50%) rotate(-45deg); }
    .close-btn:hover .x span { background: #ff8080; box-shadow: 0 0 12px rgba(255, 90, 90, 0.9); }

    /* =====================================================
       (2) SIDEBAR MENU
       ===================================================== */
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 270px;
      background: #0d0f13;
      border-right: 1px solid #1d2128;
      display: flex;
      flex-direction: column;
      padding: 1.25rem 1rem 1.5rem;
      gap: 1.5rem;
      background-image:
        radial-gradient(circle at 30% 10%, rgba(0,230,176,0.10) 0%, transparent 55%),
        linear-gradient(180deg, #101318 0%, #0a0c10 100%),
        repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(255, 255, 255, 0.012) 40px);
      box-shadow: 8px 0 40px -18px rgba(0, 0, 0, 0.95);
      transform: translateX(-100%);
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 100;
      overflow-y: auto;
    }
    .sidebar.open { transform: translateX(0); }

    .sidebar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0 0.25rem;
    }
    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: -0.4px;
      color: #f0f5fc;
      user-select: none;
    }
    .logo-icon {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: #0a1c1f;
      border: 1.5px solid #00e6b0;
      color: #00e6b0;
      font-size: 1.15rem;
      font-weight: 700;
      box-shadow: 0 0 10px rgba(0, 230, 176, 0.45);
      flex-shrink: 0;
    }

    .sidebar-nav {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      flex: 1;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .nav-item {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.7rem 0.9rem;
      border-radius: 0.65rem;
      color: #8b96a5;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.18s, color 0.18s, border-color 0.18s, box-shadow 0.18s;
      user-select: none;
    }
    .nav-item:hover {
      background: #14181f;
      color: #e2e9f2;
      border-color: #232a35;
    }
    .nav-item.active {
      background: #0f1c1e;
      color: #00e6b0;
      border-color: #0f3d38;
      box-shadow: inset 0 0 0 1px rgba(0, 230, 176, 0.25), 0 0 14px -6px rgba(0, 230, 176, 0.4);
    }
    .nav-item.active::before {
      content: '';
      position: absolute;
      left: -1rem;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 60%;
      background: #00e6b0;
      border-radius: 0 3px 3px 0;
      box-shadow: 0 0 10px #00e6b0;
    }
    .nav-icon {
      width: 18px;
      height: 18px;
      display: grid;
      place-items: center;
      font-size: 1rem;
      flex-shrink: 0;
      opacity: 0.8;
    }
    .nav-item.active .nav-icon { opacity: 1; filter: drop-shadow(0 0 6px #00e6b0); }
    .nav-label {
      margin-left: auto;
      font-size: 0.65rem;
      font-weight: 600;
      padding: 0.15rem 0.45rem;
      border-radius: 2rem;
      background: #1a1f27;
      color: #6f7c8c;
      border: 1px solid #242b36;
      letter-spacing: 0.3px;
    }
    .nav-item.active .nav-label {
      background: #0e2a25;
      color: #00e6b0;
      border-color: #0f4a42;
    }

    .sidebar-footer {
      padding-top: 1.1rem;
      border-top: 1px solid #1a1e25;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.68rem;
      color: #4b5563;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      user-select: none;
    }
    .status-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #00e6b0;
      box-shadow: 0 0 8px #00e6b0;
      margin-right: 0.4rem;
    }

    /* =====================================================
       OVERLAY
       ===================================================== */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(4, 6, 8, 0.55);
      backdrop-filter: blur(2px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
      z-index: 90;
    }
    .overlay.open { opacity: 1; visibility: visible; }

    /* =====================================================
       FAB CLUSTER — bên phải, giữa dọc
       ===================================================== */
    .fab-cluster {
      position: fixed;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 80;
      width: 55px;
      height: 55px;
    }
    .fab-btn {
      position: absolute;
      width: 55px;
      height: 55px;
      font-size: 22px;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #fff;
      background: rgba(30, 41, 59, 0.85);
      border: 2px solid #38bdf8;
      border-radius: 50%;
      cursor: pointer;
      backdrop-filter: blur(5px);
      transition: all 0.25s ease;
      padding: 0;
      user-select: none;
    }
    .fab-btn:active { transform: scale(0.9); }

    #fabMain { left: 0; top: 0; z-index: 30; }
    #fabMain.open {
      left: -70px;
      background: rgba(239, 68, 68, 0.85);
      border-color: #ef4444;
      transform: rotate(90deg);
    }
    #fabMain .icon-hamburger,
    #fabMain .icon-close {
      position: absolute;
      transition: opacity 0.2s ease, transform 0.25s ease;
    }
    #fabMain .icon-hamburger { opacity: 1; transform: scale(1); }
    #fabMain .icon-close     { opacity: 0; transform: scale(0.5); }
    #fabMain.open .icon-hamburger { opacity: 0; transform: scale(0.5); }
    #fabMain.open .icon-close     { opacity: 1; transform: scale(1); }

    #btn-zoom-in  { top: -70px; left: 0; }
    #btn-zoom-out { top: 0; left: 0; }
    #btn-pause    { top: 70px; left: 0; }

    #btn-zoom-in, #btn-zoom-out, #btn-pause {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: scale(0.5);
      transition: opacity 0.25s ease, visibility 0.25s ease, transform 0.25s ease;
    }
    .fab-cluster.show #btn-zoom-in,
    .fab-cluster.show #btn-zoom-out,
    .fab-cluster.show #btn-pause {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: scale(1);
    }
    #btn-pause.active {
      background: rgba(239, 68, 68, 0.8);
      border-color: #ef4444;
    }
  </style>
</head>
<body>

<!-- (1) HAMBURGER -->
<button class="hamburger" id="hamburger" aria-label="Mở sidebar" aria-expanded="false" aria-controls="sidebar">
  <span class="bars">
    <span></span>
    <span></span>
    <span></span>
  </span>
</button>

<!-- (2) SIDEBAR MENU -->
<aside class="sidebar" id="sidebar" aria-hidden="true">
  <div class="sidebar-header">
    <div class="sidebar-logo">
      <div class="logo-icon">◈</div>
      <span>NEXUS</span>
    </div>
    <!-- (3) CLOSE BUTTON -->
    <button class="close-btn" id="closeBtn" aria-label="Đóng sidebar">
      <span class="x">
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <!-- CHỈ CÒN 1 NAV ITEM: TUYẾT RƠI -->
  <ul class="sidebar-nav">
    <li class="nav-item" id="navSnow">
      <span class="nav-icon">❄️</span>
      <span>Tuyết rơi</span>
      <span class="nav-label" id="snowStatus">OFF</span>
    </li>
  </ul>

  <div class="sidebar-footer">
    <span><span class="status-dot"></span>online</span>
    <span>v2.4.0</span>
  </div>
</aside>

<!-- Overlay -->
<div class="overlay" id="overlay"></div>

<!-- FAB CLUSTER -->
<div class="fab-cluster" id="fabCluster">
  <div class="fab-btn" id="fabMain">
    <span class="icon-hamburger">☰</span>
    <span class="icon-close">✕</span>
  </div>
  <button class="fab-btn" id="btn-zoom-in"  title="Phóng To">➕</button>
  <button class="fab-btn" id="btn-zoom-out" title="Thu Nhỏ">➖</button>
  <button class="fab-btn" id="btn-pause"    title="Dừng Xoay">⏸️</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
  // ==========================================
  // 1. HÀM TẠO TEXTURE
  // ==========================================
  function createSnowSkyTexture() {
    const c = document.createElement('canvas'); c.width = 1024; c.height = 1024;
    const ctx = c.getContext('2d');
    const g = ctx.createLinearGradient(0, 0, 0, 1024);
    g.addColorStop(0, '#2c3e50'); g.addColorStop(0.5, '#5c7080'); g.addColorStop(1, '#a0b3c4');
    ctx.fillStyle = g; ctx.fillRect(0, 0, 1024, 1024);
    for (let i = 0; i < 60; i++) {
      const x = Math.random() * 1024, y = Math.random() * 800;
      const w = 100 + Math.random() * 200, h = 20 + Math.random() * 60;
      ctx.fillStyle = `rgba(120, 130, 150, ${0.1 + Math.random() * 0.2})`;
      ctx.beginPath(); ctx.ellipse(x, y, w, h, 0, 0, Math.PI * 2); ctx.fill();
    }
    for (let i = 0; i < 1500; i++) {
      const x = Math.random() * 1024, y = Math.random() * 1024, r = 1 + Math.random() * 3;
      ctx.fillStyle = `rgba(255, 255, 255, ${0.4 + Math.random() * 0.6})`;
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    }
    const tex = new THREE.CanvasTexture(c);
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    return tex;
  }
  function createGrassTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 256;
    const ctx = c.getContext('2d'); ctx.fillStyle = '#3a5f3a'; ctx.fillRect(0, 0, 256, 256);
    for(let i=0; i<2000; i++) { ctx.fillStyle = Math.random() > 0.5 ? '#2e4f2e' : '#4a754a'; ctx.fillRect(Math.random()*256, Math.random()*256, 2, 4); }
    const tex = new THREE.CanvasTexture(c); tex.wrapS = tex.wrapT = THREE.RepeatWrapping; tex.repeat.set(100, 100); return tex;
  }
  function createWallTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 256; const ctx = c.getContext('2d');
    ctx.fillStyle = '#e8dfc8'; ctx.fillRect(0, 0, 256, 256); ctx.fillStyle = '#5c3c26';
    ctx.fillRect(0, 0, 256, 15); ctx.fillRect(0, 241, 256, 15); ctx.fillRect(0, 0, 15, 256); ctx.fillRect(241, 0, 15, 256); ctx.fillRect(0, 120, 256, 10);
    return new THREE.CanvasTexture(c);
  }
  function createRoofTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 256; const ctx = c.getContext('2d');
    ctx.fillStyle = '#2a3345'; ctx.fillRect(0, 0, 256, 256); ctx.strokeStyle = '#1a2230'; ctx.lineWidth = 4;
    for(let y=0; y<256; y+=32) { for(let x=0; x<256; x+=32) { ctx.strokeRect(x, y, 32, 32); } }
    const tex = new THREE.CanvasTexture(c); tex.wrapS = tex.wrapT = THREE.RepeatWrapping; tex.repeat.set(4, 1); return tex;
  }
  function createWoodTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 128; const ctx = c.getContext('2d');
    ctx.fillStyle = '#5c3c26'; ctx.fillRect(0, 0, 128, 128); ctx.strokeStyle = '#3a2214'; ctx.lineWidth = 2;
    for(let i=0; i<128; i+=8) { ctx.beginPath(); ctx.moveTo(i, 0); ctx.lineTo(i, 128); ctx.stroke(); }
    return new THREE.CanvasTexture(c);
  }
  function createWindowTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 128; const ctx = c.getContext('2d');
    const g = ctx.createLinearGradient(0,0,128,128); g.addColorStop(0, '#aaddff'); g.addColorStop(1, '#4488cc');
    ctx.fillStyle = g; ctx.fillRect(0, 0, 128, 128); ctx.strokeStyle = '#222'; ctx.lineWidth = 6; ctx.strokeRect(0, 0, 128, 128);
    return new THREE.CanvasTexture(c);
  }
  function createBirdTexture() {
    const c = document.createElement('canvas'); c.width = c.height = 64; const ctx = c.getContext('2d');
    ctx.fillStyle = '#222'; ctx.fillRect(0, 0, 64, 64); ctx.strokeStyle = '#444'; ctx.lineWidth = 2;
    for(let i=0; i<10; i++) { ctx.beginPath(); ctx.moveTo(Math.random()*64, Math.random()*64); ctx.lineTo(Math.random()*64, Math.random()*64); ctx.stroke(); }
    return new THREE.CanvasTexture(c);
  }

  // ==========================================
  // 2. KHỞI TẠO CẢNH
  // ==========================================
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 2000);
  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(innerWidth, innerHeight);
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  document.body.appendChild(renderer.domElement);

  const skyGeo = new THREE.SphereGeometry(800, 32, 32);
  const skyMat = new THREE.MeshBasicMaterial({ map: createSnowSkyTexture(), side: THREE.BackSide, depthWrite: false });
  const sky = new THREE.Mesh(skyGeo, skyMat);
  scene.add(sky);

  const ambient = new THREE.AmbientLight(0xd0e0ff, 0.8);
  scene.add(ambient);
  const sun = new THREE.DirectionalLight(0xffffff, 0.6);
  sun.position.set(10, 20, 10);
  scene.add(sun);

  // ==========================================
  // 3. MẶT ĐẤT & NHÀ
  // ==========================================
  const groundGeo = new THREE.PlaneGeometry(2000, 2000);
  const groundMat = new THREE.MeshStandardMaterial({ map: createGrassTexture(), roughness: 1 });
  const ground = new THREE.Mesh(groundGeo, groundMat);
  ground.rotation.x = -Math.PI / 2; ground.position.y = -1.5;
  scene.add(ground);

  const houseGroup = new THREE.Group();
  const body = new THREE.Mesh(new THREE.BoxGeometry(2, 1.5, 2), new THREE.MeshStandardMaterial({ map: createWallTexture(), roughness: 0.8 }));
  body.position.y = 0.75; houseGroup.add(body);
  const roof = new THREE.Mesh(new THREE.ConeGeometry(1.8, 1.2, 4), new THREE.MeshStandardMaterial({ map: createRoofTexture(), roughness: 0.6 }));
  roof.position.y = 2.1; roof.rotation.y = Math.PI / 4; houseGroup.add(roof);
  const door = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.7, 0.05), new THREE.MeshStandardMaterial({ map: createWoodTexture() }));
  door.position.set(0, 0.35, 1.02); houseGroup.add(door);
  const windowMat = new THREE.MeshStandardMaterial({ map: createWindowTexture(), emissive: 0x4488cc, emissiveMap: createWindowTexture(), emissiveIntensity: 0.8 });
  const win1 = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.3, 0.05), windowMat); win1.position.set(-0.6, 0.8, 1.02); houseGroup.add(win1);
  const win2 = new THREE.Mesh(new THREE.BoxGeometry(0.3, 0.3, 0.05), windowMat); win2.position.set(0.6, 0.8, 1.02); houseGroup.add(win2);
  houseGroup.position.y = -1.5;
  scene.add(houseGroup);

  // ==========================================
  // 4. CHIM
  // ==========================================
  const birds = [];
  const birdMat = new THREE.MeshBasicMaterial({ map: createBirdTexture(), side: THREE.DoubleSide });
  function createBird() {
    const birdGroup = new THREE.Group();
    const wingL = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 0.15), birdMat); wingL.position.x = -0.2; birdGroup.add(wingL);
    const wingR = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 0.15), birdMat); wingR.position.x = 0.2; birdGroup.add(wingR);
    return birdGroup;
  }
  for(let i = 0; i < 12; i++) {
    const bird = createBird();
    bird.userData = { speed: 0.05 + Math.random() * 0.08, dir: Math.random() > 0.5 ? 1 : -1, startX: -40, zPos: -20 + Math.random() * 40, height: 4 + Math.random() * 8, flapSpeed: 5 + Math.random() * 3 };
    if (bird.userData.dir === -1) bird.userData.startX = 40;
    bird.position.set(bird.userData.startX, bird.userData.height, bird.userData.zPos);
    scene.add(bird); birds.push(bird);
  }

  // ==========================================
  // 5. CAMERA / ZOOM / PAUSE
  // ==========================================
  let camDistance = 20;
  let isPaused = false;
  camera.position.set(0, 3, camDistance);
  camera.lookAt(0, 0, 0);

  document.getElementById('btn-zoom-in').onclick  = () => { camDistance = Math.max(3, camDistance - 2); };
  document.getElementById('btn-zoom-out').onclick = () => { camDistance = Math.min(100, camDistance + 2); };

  const btnPause = document.getElementById('btn-pause');
  btnPause.onclick = () => {
    isPaused = !isPaused;
    btnPause.innerText = isPaused ? "▶️" : "⏸️";
    btnPause.classList.toggle('active', isPaused);
  };

  // ==========================================
  // 6. FAB TOGGLE (bên phải)
  // ==========================================
  const fabMain = document.getElementById('fabMain');
  const fabCluster = document.getElementById('fabCluster');
  fabMain.addEventListener('click', () => {
    const isOpen = fabMain.classList.toggle('open');
    fabCluster.classList.toggle('show', isOpen);
  });

  // ==========================================
  // 7. SIDEBAR + HAMBURGER + CLOSE
  // ==========================================
  const hamburger = document.getElementById('hamburger');
  const sidebar = document.getElementById('sidebar');
  const closeBtn = document.getElementById('closeBtn');
  const overlay = document.getElementById('overlay');

  function openSidebar() {
    sidebar.classList.add('open');
    sidebar.setAttribute('aria-hidden', 'false');
    overlay.classList.add('open');
    hamburger.classList.add('hidden');
    hamburger.setAttribute('aria-expanded', 'true');
  }
  function closeSidebar() {
    sidebar.classList.remove('open');
    sidebar.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('open');
    hamburger.classList.remove('hidden');
    hamburger.setAttribute('aria-expanded', 'false');
  }

  hamburger.addEventListener('click', openSidebar);
  closeBtn.addEventListener('click', closeSidebar);
  overlay.addEventListener('click', closeSidebar);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar.classList.contains('open')) closeSidebar();
  });

  // ==========================================
  // 8. NÚT TUYẾT RƠI (nav item duy nhất)
  // ==========================================
  let snowPoints = null;
  const navSnow = document.getElementById('navSnow');
  const snowStatus = document.getElementById('snowStatus');

  navSnow.addEventListener('click', () => {
    if (snowPoints) {
      scene.remove(snowPoints);
      snowPoints.geometry.dispose();
      snowPoints.material.dispose();
      snowPoints = null;
      snowStatus.textContent = 'OFF';
      navSnow.classList.remove('active');
      return;
    }
    const count = 1500;
    const positions = new Float32Array(count * 3);
    for (let i = 0; i < count; i++) {
      positions[i*3]     = (Math.random() - 0.5) * 200;
      positions[i*3 + 1] = Math.random() * 80;
      positions[i*3 + 2] = (Math.random() - 0.5) * 200;
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const mat = new THREE.PointsMaterial({ color: 0xffffff, size: 0.6, transparent: true, opacity: 0.85 });
    snowPoints = new THREE.Points(geo, mat);
    scene.add(snowPoints);
    snowStatus.textContent = 'ON';
    navSnow.classList.add('active');
  });

  // ==========================================
  // 9. RENDER LOOP
  // ==========================================
  let time = 0;
  function animate() {
    requestAnimationFrame(animate);
    if (!isPaused) time += 0.01;

    camera.position.x = Math.sin(time * 0.5) * camDistance;
    camera.position.z = Math.cos(time * 0.5) * camDistance;
    camera.position.y = camDistance * 0.3;
    camera.lookAt(0, -0.5, 0);

    sky.position.copy(camera.position);
    sky.rotation.y += 0.0005;

    if (snowPoints && !isPaused) {
      const pos = snowPoints.geometry.attributes.position;
      for (let i = 0; i < pos.count; i++) {
        let y = pos.getY(i) - 0.08;
        if (y < -1.5) y = 80;
        pos.setY(i, y);
      }
      pos.needsUpdate = true;
    }

    birds.forEach(bird => {
      const d = bird.userData;
      bird.position.x += d.speed * d.dir;
      if (d.dir === 1 && bird.position.x > 40) bird.position.x = -40;
      if (d.dir === -1 && bird.position.x < -40) bird.position.x = 40;
      bird.position.y = d.height + Math.sin(time * 2 + bird.position.x) * 0.3;
      bird.rotation.y = d.dir === 1 ? 0 : Math.PI;
      const flap = Math.sin(time * d.flapSpeed) * 0.6;
      bird.children[0].rotation.z = flap;
      bird.children[1].rotation.z = -flap;
    });

    renderer.render(scene, camera);
  }
  animate();

  addEventListener('resize', () => {
    camera.aspect = innerWidth / innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(innerWidth, innerHeight);
  });
</script>
</body>
</html>