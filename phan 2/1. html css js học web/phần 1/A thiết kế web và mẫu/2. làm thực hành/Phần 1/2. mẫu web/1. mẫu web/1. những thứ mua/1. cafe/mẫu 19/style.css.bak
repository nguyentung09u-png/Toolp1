/* =========================================================
   TIỆM CÀ PHÊ — NORDIC MIDNIGHT SLATE & GLACIER ICE-BAR
   Visual Redesign v14: Midnight Slate, Glacier Mint & Apricot
   ========================================================= */

/* ===== RESET & BASE ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

:root {
  /* Bảng màu nền & bề mặt (Midnight Slate & Frosted Charcoal) */
  --bg-slate: #0E1318;
  --bg-abyss: #121820;
  --surface-card: #161D24;
  --surface-card-hover: #1C252E;
  --surface-nav: rgba(14, 19, 24, 0.88);
  --surface-mint-tint: rgba(45, 212, 191, 0.11);

  /* Bảng màu chữ (Snow White & Glacier Mist) */
  --ink-snow: #F4F7FA;
  --ink-mist: #9AA8B6;
  --ink-muted: #64748B;
  --ink-dark: #0B1015;

  /* Điểm nhấn Cold Brew & Ice-Bar (Glacier Mint & Roasted Apricot) */
  --mint: #2DD4BF;
  --mint-light: #5EEAD4;
  --mint-glow: rgba(45, 212, 191, 0.28);
  --apricot: #FB923C;
  --apricot-soft: rgba(251, 146, 60, 0.12);

  /* Viền & Đổ bóng */
  --border-slate: rgba(244, 247, 250, 0.08);
  --border-mint: rgba(45, 212, 191, 0.34);
  --shadow-card: 0 14px 30px -12px rgba(4, 7, 11, 0.78), 0 2px 8px rgba(4, 7, 11, 0.45);
  --shadow-card-hover: 0 22px 44px -12px rgba(4, 7, 11, 0.9), 0 0 0 1px rgba(45, 212, 191, 0.32);
  --shadow-fab: 0 14px 32px -6px rgba(4, 7, 11, 0.85), 0 4px 18px rgba(45, 212, 191, 0.3);

  /* Bo góc hiện đại */
  --radius-sm: 10px;
  --radius-md: 15px;
  --radius-lg: 20px;
  --radius-pill: 999px;

  /* Chuyển động 60FPS */
  --ease-nordic: cubic-bezier(0.22, 1, 0.36, 1);
}

body {
  background-color: var(--bg-slate);
  background-image:
    radial-gradient(840px 440px at 50% -10%, rgba(45, 212, 191, 0.11), transparent 70%),
    radial-gradient(640px 460px at 10% 42%, rgba(56, 189, 248, 0.06), transparent 65%),
    radial-gradient(700px 480px at 90% 88%, rgba(251, 146, 60, 0.06), transparent 65%);
  color: var(--ink-snow);
  line-height: 1.55;
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ===== HEADER ===== */
.header {
  position: relative;
  padding: 64px 20px 48px;
  text-align: center;
  background: linear-gradient(180deg, #131A22 0%, var(--bg-slate) 100%);
  border-bottom: 1px solid var(--border-slate);
  overflow: hidden;
}

/* Thanh ánh sáng Glacier Mint mảnh ở đỉnh trang */
.header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(560px, 85%);
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--mint), transparent);
}

.header-content {
  position: relative;
  z-index: 1;
  max-width: 720px;
  margin: 0 auto;
}

.header-content::before {
  content: 'COLD BREW & ARTISAN TEA BAR';
  display: inline-block;
  margin-bottom: 16px;
  padding: 5px 15px;
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--mint-light);
  background: var(--surface-mint-tint);
  border: 1px solid var(--border-mint);
  border-radius: var(--radius-pill);
}

.shop-name {
  font-size: clamp(2.15rem, 5.6vw, 3.35rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.025em;
  background: linear-gradient(135deg, #FFFFFF 0%, var(--ink-snow) 55%, var(--mint-light) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-wrap: balance;
}

.shop-slogan {
  margin-top: 15px;
  font-size: clamp(0.88rem, 2.2vw, 0.98rem);
  font-weight: 400;
  letter-spacing: 0.015em;
  color: var(--ink-mist);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 7px 18px;
  background: rgba(255, 255, 255, 0.025);
  border: 1px solid var(--border-slate);
  border-radius: var(--radius-pill);
}

.shop-slogan::before,
.shop-slogan::after {
  content: '•';
  font-size: 0.85rem;
  color: var(--mint);
}

/* ===== BỘ LỌC DANH MỤC (STICKY FILTER BAR) ===== */
.filter-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  padding: 14px 20px;
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--surface-nav);
  backdrop-filter: blur(16px) saturate(140%);
  -webkit-backdrop-filter: blur(16px) saturate(140%);
  border-bottom: 1px solid var(--border-slate);
}

.filter-btn {
  appearance: none;
  padding: 9px 17px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border-slate);
  background: var(--surface-card);
  color: var(--ink-mist);
  font-weight: 600;
  font-size: 0.82rem;
  letter-spacing: 0.015em;
  cursor: pointer;
  transition:
    transform 0.25s var(--ease-nordic),
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease;
  will-change: transform;
}

.filter-btn:hover {
  color: var(--ink-snow);
  background: var(--surface-card-hover);
  border-color: var(--border-mint);
  transform: translateY(-1px);
}

.filter-btn:active {
  transform: translateY(0) scale(0.98);
}

.filter-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg-slate), 0 0 0 4px var(--mint);
}

.filter-btn.active {
  color: var(--ink-dark);
  background: linear-gradient(135deg, var(--mint-light) 0%, var(--mint) 100%);
  border-color: var(--mint-light);
  font-weight: 700;
  box-shadow: 0 6px 18px -4px var(--mint-glow);
}

.filter-btn.active:hover {
  color: var(--ink-dark);
  filter: brightness(1.05);
}

/* ===== LƯỚI SẢN PHẨM (GRID 2 CỘT) ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
  padding: 38px 24px 76px;
  max-width: 1120px;
  margin: 0 auto;
}

.product-grid > p {
  color: var(--ink-mist) !important;
  font-weight: 600;
  background: var(--surface-card);
  border: 1px solid var(--border-slate);
  border-radius: var(--radius-lg);
}

/* ===== CARD MÓN UỐNG & BÁNH ===== */
.product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--surface-card);
  border: 1px solid var(--border-slate);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition:
    transform 0.35s var(--ease-nordic),
    background-color 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.35s var(--ease-nordic);
  will-change: transform;
}

.product-card:hover {
  transform: translateY(-4px);
  background: var(--surface-card-hover);
  border-color: var(--border-mint);
  box-shadow: var(--shadow-card-hover);
}

.card-image {
  width: 100%;
  height: 228px;
  object-fit: cover;
  display: block;
  background-color: #1B232C;
  background-image: linear-gradient(110deg, #161D24 8%, #222C37 18%, #161D24 33%);
  background-size: 200% 100%;
  animation: slateShimmer 1.8s linear infinite;
  filter: brightness(0.96) contrast(1.04);
  transition: transform 0.55s var(--ease-nordic), filter 0.35s ease;
  will-change: transform;
}

.product-card:hover .card-image {
  transform: scale(1.035);
  filter: brightness(1.02) contrast(1.06);
}

@keyframes slateShimmer {
  to {
    background-position-x: -200%;
  }
}

.card-body {
  position: relative;
  padding: 16px 18px 18px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  background: linear-gradient(180deg, rgba(22, 29, 36, 0.96) 0%, #121820 100%);
  border-top: 1px solid var(--border-slate);
}

.card-category-tag {
  align-self: flex-start;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--mint-light);
  background: var(--surface-mint-tint);
  border: 1px solid rgba(45, 212, 191, 0.22);
  padding: 3px 10px;
  border-radius: var(--radius-pill);
  margin-bottom: 9px;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-name {
  font-size: 1.04rem;
  font-weight: 700;
  line-height: 1.38;
  color: var(--ink-snow);
  margin-bottom: 8px;
  letter-spacing: -0.01em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: calc(1.04rem * 1.38 * 2);
  word-break: break-word;
}

.card-price {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  font-size: 1.12rem;
  font-weight: 800;
  letter-spacing: 0.01em;
  color: var(--apricot);
  background: var(--apricot-soft);
  padding: 4px 11px;
  border-radius: var(--radius-sm);
  margin-bottom: 16px;
  font-variant-numeric: tabular-nums;
}

.card-btn {
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 11px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-mint);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.015em;
  text-decoration: none;
  color: var(--ink-snow);
  background: rgba(45, 212, 191, 0.1);
  cursor: pointer;
  white-space: nowrap;
  line-height: 1.2;
  transition:
    transform 0.25s var(--ease-nordic),
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease;
  will-change: transform;
}

.card-btn:hover {
  background: linear-gradient(135deg, var(--mint-light) 0%, var(--mint) 100%);
  border-color: var(--mint-light);
  color: var(--ink-dark);
  transform: translateY(-1px);
  box-shadow: 0 8px 20px -6px var(--mint-glow);
}

.card-btn:active {
  transform: translateY(0) scale(0.985);
}

.card-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg-slate), 0 0 0 4px var(--mint);
}

.card-btn img {
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #FFFFFF;
  padding: 1.5px;
  flex-shrink: 0;
}

/* ===== FOOTER ===== */
.footer {
  position: relative;
  text-align: center;
  padding: 46px 20px 104px;
  color: var(--ink-mist);
  font-size: 0.85rem;
  background: #0A0E12;
  border-top: 1px solid var(--border-slate);
}

.footer::before {
  content: 'TIỆM CÀ PHÊ';
  display: block;
  margin-bottom: 10px;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.24em;
  color: var(--mint);
}

.footer p {
  margin-bottom: 6px;
  color: var(--ink-mist);
  font-weight: 400;
}

.footer p:last-child {
  margin-top: 14px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--mint-light);
  background: var(--surface-card);
  border: 1px solid var(--border-mint);
  border-radius: var(--radius-pill);
}

/* ===== NÚT LIÊN HỆ ZALO (FAB) ===== */
.fab-zalo {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px 10px 10px;
  border-radius: var(--radius-pill);
  text-decoration: none;
  color: var(--ink-dark);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.01em;
  background: linear-gradient(135deg, var(--mint-light) 0%, var(--mint) 100%);
  border: 1.5px solid rgba(255, 255, 255, 0.35);
  box-shadow: var(--shadow-fab);
  z-index: 100;
  transition:
    transform 0.3s var(--ease-nordic),
    filter 0.25s ease,
    box-shadow 0.3s ease;
  will-change: transform;
}

.fab-zalo:hover {
  transform: translateY(-3px) scale(1.02);
  filter: brightness(1.06);
  box-shadow: 0 18px 36px -6px rgba(4, 7, 11, 0.9), 0 0 24px -2px rgba(45, 212, 191, 0.45);
}

.fab-zalo:active {
  transform: translateY(0) scale(0.97);
}

.fab-zalo:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px var(--bg-slate), 0 0 0 5px var(--mint-light);
}

.fab-zalo img {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #FFFFFF;
  padding: 2px;
  flex-shrink: 0;
}

.fab-zalo span {
  white-space: nowrap;
}

/* ===== REDUCED MOTION ===== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* ===== RESPONSIVE (TABLET & MOBILE) ===== */
@media (max-width: 900px) {
  .product-grid {
    gap: 18px;
    padding: 32px 18px 60px;
  }

  .card-image {
    height: 196px;
  }
}

@media (max-width: 768px) {
  .header {
    padding: 46px 16px 36px;
  }

  .header-content::before {
    font-size: 0.62rem;
    padding: 4px 12px;
    letter-spacing: 0.14em;
  }

  .filter-nav {
    gap: 6px;
    padding: 12px 10px;
  }

  .filter-btn {
    padding: 7px 13px;
    font-size: 0.77rem;
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    padding: 24px 14px 52px;
  }

  .card-image {
    height: 162px;
  }

  .card-body {
    padding: 13px 14px 15px;
  }

  .card-category-tag {
    font-size: 0.6rem;
    padding: 3px 8px;
    margin-bottom: 8px;
  }

  .card-name {
    font-size: 0.92rem;
    min-height: calc(0.92rem * 1.38 * 2);
    margin-bottom: 6px;
  }

  .card-price {
    font-size: 0.98rem;
    padding: 3px 9px;
    margin-bottom: 12px;
  }

  .card-btn {
    padding: 10px 10px;
    font-size: 0.78rem;
    gap: 6px;
    border-radius: 12px;
  }

  .footer {
    padding: 38px 16px 96px;
  }

  .fab-zalo {
    bottom: 16px;
    right: 16px;
    padding: 9px 15px 9px 9px;
    font-size: 0.8rem;
  }
}

@media (max-width: 400px) {
  .header {
    padding: 40px 12px 30px;
  }

  .product-grid {
    gap: 10px;
    padding: 20px 10px 48px;
  }

  .card-image {
    height: 140px;
  }

  .card-body {
    padding: 11px 11px 13px;
  }

  .card-name {
    font-size: 0.84rem;
    min-height: calc(0.84rem * 1.38 * 2);
  }

  .card-price {
    font-size: 0.92rem;
  }

  .card-btn {
    font-size: 0.72rem;
    padding: 9px 8px;
    gap: 5px;
  }

  .fab-zalo {
    padding: 10px;
    border-radius: 50%;
  }

  .fab-zalo span {
    display: none;
  }
}

@media (max-width: 330px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}
