/* =========================================================
   TIỆM CÀ PHÊ — AMALFI COASTAL ESPRESSO & CAPRI CERAMIC
   Visual Redesign v10: Sea Salt Linen, Capri Cobalt & Citrus
   ========================================================= */

/* ===== RESET & BASE ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

:root {
  /* Bảng màu nền & bề mặt (Sea Salt Linen & Porcelain Tile) */
  --bg-linen: #F5F8FA;
  --bg-mist-blue: #E8EFF5;
  --surface-tile: #FFFFFF;
  --surface-nav: rgba(245, 248, 250, 0.88);
  --surface-citrus: rgba(217, 138, 22, 0.11);

  /* Bảng màu chữ (Deep Marine Ink & Coastal Slate) */
  --ink-marine: #10243E;
  --ink-slate: #4A607A;
  --ink-muted: #7C90A8;
  --ink-white: #FFFFFF;

  /* Điểm nhấn Địa Trung Hải (Capri Cobalt, Amalfi Citrus & Terracotta) */
  --capri: #165296;
  --capri-hover: #0F3E75;
  --capri-soft: rgba(22, 82, 150, 0.08);
  --citrus: #C97A0C;
  --terracotta: #C95634;
  --terracotta-soft: rgba(201, 86, 52, 0.1);

  /* Viền gốm & Đổ bóng tươi sáng */
  --border-marine: rgba(16, 36, 62, 0.1);
  --border-capri: rgba(22, 82, 150, 0.28);
  --shadow-card: 0 10px 26px -10px rgba(16, 36, 62, 0.09), 0 2px 6px rgba(16, 36, 62, 0.03);
  --shadow-card-hover: 0 20px 38px -12px rgba(22, 82, 150, 0.18), 0 4px 12px rgba(16, 36, 62, 0.05);
  --shadow-fab: 0 12px 28px -6px rgba(16, 36, 62, 0.32), 0 4px 14px rgba(22, 82, 150, 0.3);

  /* Bo góc hiện đại */
  --radius-sm: 10px;
  --radius-md: 15px;
  --radius-lg: 20px;
  --radius-pill: 999px;

  /* Chuyển động 60FPS */
  --ease-coastal: cubic-bezier(0.22, 1, 0.36, 1);
}

body {
  background-color: var(--bg-linen);
  background-image:
    radial-gradient(840px 440px at 12% 0%, rgba(22, 82, 150, 0.08), transparent 65%),
    radial-gradient(740px 460px at 90% 8%, rgba(217, 138, 22, 0.09), transparent 65%),
    radial-gradient(820px 500px at 50% 96%, rgba(22, 82, 150, 0.06), transparent 70%);
  color: var(--ink-marine);
  line-height: 1.55;
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ===== HEADER ===== */
.header {
  position: relative;
  padding: 64px 20px 48px;
  text-align: center;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-linen) 100%);
  border-bottom: 1px solid var(--border-marine);
  overflow: hidden;
}

/* Dải họa tiết gốm Capri mảnh ở mép trên */
.header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background: repeating-linear-gradient(
    90deg,
    var(--capri) 0px,
    var(--capri) 28px,
    #FFFFFF 28px,
    #FFFFFF 36px,
    #E09F1F 36px,
    #E09F1F 52px,
    #FFFFFF 52px,
    #FFFFFF 60px
  );
}

.header-content {
  position: relative;
  z-index: 1;
  max-width: 720px;
  margin: 0 auto;
}

.header-content::before {
  content: 'COASTAL COFFEE & TEA HOUSE';
  display: inline-block;
  margin-bottom: 16px;
  padding: 5px 15px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--capri);
  background: var(--capri-soft);
  border: 1px solid var(--border-capri);
  border-radius: var(--radius-pill);
}

.shop-name {
  font-size: clamp(2.15rem, 5.6vw, 3.35rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.025em;
  color: var(--ink-marine);
  text-wrap: balance;
}

.shop-slogan {
  margin-top: 15px;
  font-size: clamp(0.88rem, 2.2vw, 0.98rem);
  font-weight: 500;
  letter-spacing: 0.01em;
  color: var(--ink-slate);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 7px 18px;
  background: var(--surface-tile);
  border: 1px solid var(--border-marine);
  border-radius: var(--radius-pill);
  box-shadow: 0 3px 12px rgba(16, 36, 62, 0.04);
}

.shop-slogan::before,
.shop-slogan::after {
  content: '☀';
  font-size: 0.72rem;
  color: var(--citrus);
}

/* ===== BỘ LỌC DANH MỤC (STICKY MENU BAR) ===== */
.filter-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  padding: 14px 20px;
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--surface-nav);
  backdrop-filter: blur(14px) saturate(145%);
  -webkit-backdrop-filter: blur(14px) saturate(145%);
  border-bottom: 1px solid var(--border-marine);
}

.filter-btn {
  appearance: none;
  padding: 9px 17px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border-marine);
  background: var(--surface-tile);
  color: var(--ink-slate);
  font-weight: 600;
  font-size: 0.82rem;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition:
    transform 0.25s var(--ease-coastal),
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease;
  will-change: transform;
}

.filter-btn:hover {
  color: var(--capri);
  border-color: var(--capri);
  background: #FFFFFF;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(22, 82, 150, 0.08);
}

.filter-btn:active {
  transform: translateY(0) scale(0.98);
}

.filter-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg-linen), 0 0 0 4px var(--capri);
}

.filter-btn.active {
  color: var(--ink-white);
  background: var(--capri);
  border-color: var(--capri);
  box-shadow: 0 6px 16px -4px rgba(22, 82, 150, 0.36);
}

.filter-btn.active:hover {
  background: var(--capri-hover);
  border-color: var(--capri-hover);
  color: var(--ink-white);
}

/* ===== LƯỚI SẢN PHẨM (GRID 2 CỘT) ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
  padding: 38px 24px 76px;
  max-width: 1120px;
  margin: 0 auto;
}

.product-grid > p {
  color: var(--ink-slate) !important;
  font-weight: 600;
  background: var(--surface-tile);
  border: 1px solid var(--border-marine);
  border-radius: var(--radius-lg);
}

/* ===== CARD MÓN UỐNG & BÁNH ===== */
.product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--surface-tile);
  border: 1px solid var(--border-marine);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition:
    transform 0.35s var(--ease-coastal),
    border-color 0.25s ease,
    box-shadow 0.35s var(--ease-coastal);
  will-change: transform;
}

.product-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-capri);
  box-shadow: var(--shadow-card-hover);
}

.card-image {
  width: 100%;
  height: 226px;
  object-fit: cover;
  display: block;
  background-color: var(--bg-mist-blue);
  background-image: linear-gradient(110deg, #E8EFF5 8%, #F6F9FC 18%, #E8EFF5 33%);
  background-size: 200% 100%;
  animation: coastalShimmer 1.8s linear infinite;
  transition: transform 0.55s var(--ease-coastal), filter 0.35s ease;
  will-change: transform;
}

.product-card:hover .card-image {
  transform: scale(1.035);
  filter: saturate(1.06);
}

@keyframes coastalShimmer {
  to {
    background-position-x: -200%;
  }
}

.card-body {
  position: relative;
  padding: 16px 18px 18px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  background: var(--surface-tile);
  border-top: 1px solid var(--border-marine);
}

.card-category-tag {
  align-self: flex-start;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--citrus);
  background: var(--surface-citrus);
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  margin-bottom: 9px;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-name {
  font-size: 1.04rem;
  font-weight: 700;
  line-height: 1.38;
  color: var(--ink-marine);
  margin-bottom: 8px;
  letter-spacing: -0.01em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: calc(1.04rem * 1.38 * 2);
  word-break: break-word;
}

.card-price {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  font-size: 1.12rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--terracotta);
  background: var(--terracotta-soft);
  padding: 4px 11px;
  border-radius: var(--radius-sm);
  margin-bottom: 16px;
  font-variant-numeric: tabular-nums;
}

.card-btn {
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 11px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--capri);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.01em;
  text-decoration: none;
  color: var(--ink-white);
  background: var(--capri);
  cursor: pointer;
  white-space: nowrap;
  line-height: 1.2;
  transition:
    transform 0.25s var(--ease-coastal),
    background-color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease;
  will-change: transform;
}

.card-btn:hover {
  background: var(--ink-marine);
  border-color: var(--ink-marine);
  color: var(--ink-white);
  transform: translateY(-1px);
  box-shadow: 0 8px 18px -6px rgba(16, 36, 62, 0.34);
}

.card-btn:active {
  transform: translateY(0) scale(0.985);
}

.card-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 4px var(--capri);
}

.card-btn img {
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #FFFFFF;
  padding: 1.5px;
  flex-shrink: 0;
}

/* ===== FOOTER ===== */
.footer {
  position: relative;
  text-align: center;
  padding: 46px 20px 104px;
  color: var(--ink-slate);
  font-size: 0.85rem;
  background: #FFFFFF;
  border-top: 1px solid var(--border-marine);
}

.footer::before {
  content: 'TIỆM CÀ PHÊ';
  display: block;
  margin-bottom: 10px;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.22em;
  color: var(--capri);
}

.footer p {
  margin-bottom: 6px;
  color: var(--ink-slate);
  font-weight: 400;
}

.footer p:last-child {
  margin-top: 14px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--ink-marine);
  background: var(--bg-linen);
  border: 1px solid var(--border-capri);
  border-radius: var(--radius-pill);
}

/* ===== NÚT LIÊN HỆ ZALO (FAB) ===== */
.fab-zalo {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px 10px 10px;
  border-radius: var(--radius-pill);
  text-decoration: none;
  color: var(--ink-white);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.01em;
  background: var(--ink-marine);
  border: 1.5px solid rgba(255, 255, 255, 0.25);
  box-shadow: var(--shadow-fab);
  z-index: 100;
  transition:
    transform 0.3s var(--ease-coastal),
    background-color 0.25s ease,
    box-shadow 0.3s ease;
  will-change: transform;
}

.fab-zalo:hover {
  background: var(--capri);
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 16px 32px -6px rgba(22, 82, 150, 0.44);
}

.fab-zalo:active {
  transform: translateY(0) scale(0.97);
}

.fab-zalo:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px var(--bg-linen), 0 0 0 5px var(--capri);
}

.fab-zalo img {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #FFFFFF;
  padding: 2px;
  flex-shrink: 0;
}

.fab-zalo span {
  white-space: nowrap;
}

/* ===== REDUCED MOTION ===== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* ===== RESPONSIVE (TABLET & MOBILE) ===== */
@media (max-width: 900px) {
  .product-grid {
    gap: 18px;
    padding: 32px 18px 60px;
  }

  .card-image {
    height: 196px;
  }
}

@media (max-width: 768px) {
  .header {
    padding: 48px 16px 38px;
  }

  .header-content::before {
    font-size: 0.62rem;
    padding: 4px 12px;
    letter-spacing: 0.14em;
  }

  .filter-nav {
    gap: 6px;
    padding: 12px 10px;
  }

  .filter-btn {
    padding: 7px 13px;
    font-size: 0.77rem;
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    padding: 24px 14px 52px;
  }

  .card-image {
    height: 162px;
  }

  .card-body {
    padding: 13px 14px 15px;
  }

  .card-category-tag {
    font-size: 0.6rem;
    padding: 3px 8px;
    margin-bottom: 8px;
  }

  .card-name {
    font-size: 0.92rem;
    min-height: calc(0.92rem * 1.38 * 2);
    margin-bottom: 6px;
  }

  .card-price {
    font-size: 0.98rem;
    padding: 3px 9px;
    margin-bottom: 12px;
  }

  .card-btn {
    padding: 10px 10px;
    font-size: 0.78rem;
    gap: 6px;
    border-radius: 12px;
  }

  .footer {
    padding: 38px 16px 96px;
  }

  .fab-zalo {
    bottom: 16px;
    right: 16px;
    padding: 9px 15px 9px 9px;
    font-size: 0.8rem;
  }
}

@media (max-width: 400px) {
  .header {
    padding: 40px 12px 30px;
  }

  .product-grid {
    gap: 10px;
    padding: 20px 10px 48px;
  }

  .card-image {
    height: 140px;
  }

  .card-body {
    padding: 11px 11px 13px;
  }

  .card-name {
    font-size: 0.84rem;
    min-height: calc(0.84rem * 1.38 * 2);
  }

  .card-price {
    font-size: 0.9rem;
    padding: 3px 8px;
  }

  .card-btn {
    font-size: 0.72rem;
    padding: 9px 8px;
    gap: 5px;
  }

  .fab-zalo {
    padding: 10px;
    border-radius: 50%;
  }

  .fab-zalo span {
    display: none;
  }
}

@media (max-width: 330px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}
