/* =========================================================
   TIỆM CÀ PHÊ — MARRAKECH COURTYARD & FIG SAFFRON CAFE
   Visual Redesign v13: Rose-Sand, Deep Fig & Spiced Saffron
   ========================================================= */

/* ===== RESET & BASE ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

:root {
  /* Bảng màu nền & bề mặt (Sunlit Rose-Sand & Plaster White) */
  --bg-sand: #F5ECE6;
  --bg-clay-tint: #EADCD3;
  --surface-plaster: #FFFDFB;
  --surface-nav: rgba(245, 236, 230, 0.88);
  --surface-mint-tint: rgba(31, 110, 104, 0.09);

  /* Bảng màu chữ (Deep Fig Ink & Mulberry Slate) */
  --ink-fig: #2B192E;
  --ink-mulberry: #614E64;
  --ink-muted: #8E7C91;
  --ink-cream: #FFFDFB;

  /* Điểm nhấn (Spiced Saffron & Moroccan Mint) */
  --saffron: #D98218;
  --saffron-hover: #BF6E0E;
  --saffron-soft: rgba(217, 130, 24, 0.11);
  --mint-jade: #1F6E68;
  --mint-dark: #16544F;

  /* Viền & Đổ bóng ấm */
  --border-clay: rgba(43, 25, 46, 0.1);
  --border-saffron: rgba(217, 130, 24, 0.34);
  --shadow-card: 0 10px 26px -10px rgba(43, 25, 46, 0.1), 0 2px 6px rgba(43, 25, 46, 0.03);
  --shadow-card-hover: 0 20px 38px -12px rgba(43, 25, 46, 0.18), 0 4px 12px rgba(217, 130, 24, 0.1);
  --shadow-fab: 0 12px 28px -6px rgba(43, 25, 46, 0.34), 0 4px 14px rgba(31, 110, 104, 0.28);

  /* Bo góc mềm mại */
  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 22px;
  --radius-pill: 999px;

  /* Chuyển động 60FPS */
  --ease-riad: cubic-bezier(0.22, 1, 0.36, 1);
}

body {
  background-color: var(--bg-sand);
  background-image:
    radial-gradient(840px 440px at 12% 0%, rgba(217, 130, 24, 0.09), transparent 65%),
    radial-gradient(740px 460px at 90% 8%, rgba(31, 110, 104, 0.08), transparent 65%),
    radial-gradient(820px 500px at 50% 96%, rgba(43, 25, 46, 0.05), transparent 70%);
  color: var(--ink-fig);
  line-height: 1.55;
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ===== HEADER ===== */
.header {
  position: relative;
  padding: 64px 20px 48px;
  text-align: center;
  background: linear-gradient(180deg, var(--surface-plaster) 0%, var(--bg-sand) 100%);
  border-bottom: 1px solid var(--border-clay);
  overflow: hidden;
}

/* Vòm trang trí mảnh gợi nhắc kiến trúc sân vườn */
.header::before {
  content: '';
  position: absolute;
  width: 340px;
  height: 170px;
  top: -85px;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  border: 1.5px solid rgba(217, 130, 24, 0.24);
  background: radial-gradient(circle, rgba(217, 130, 24, 0.07) 0%, transparent 70%);
  pointer-events: none;
}

.header-content {
  position: relative;
  z-index: 1;
  max-width: 720px;
  margin: 0 auto;
}

.header-content::before {
  content: 'ARTISAN COFFEE & MINT TEA';
  display: inline-block;
  margin-bottom: 15px;
  padding: 5px 15px;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--mint-dark);
  background: var(--surface-mint-tint);
  border: 1px solid rgba(31, 110, 104, 0.26);
  border-radius: var(--radius-pill);
}

.shop-name {
  font-size: clamp(2.15rem, 5.6vw, 3.35rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.025em;
  color: var(--ink-fig);
  text-wrap: balance;
}

.shop-slogan {
  margin-top: 14px;
  font-size: clamp(0.88rem, 2.2vw, 0.98rem);
  font-weight: 500;
  letter-spacing: 0.01em;
  color: var(--ink-mulberry);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 7px 18px;
  background: var(--surface-plaster);
  border: 1px solid var(--border-clay);
  border-radius: var(--radius-pill);
  box-shadow: 0 3px 12px rgba(43, 25, 46, 0.04);
}

.shop-slogan::before,
.shop-slogan::after {
  content: '✦';
  font-size: 0.68rem;
  color: var(--saffron);
}

/* ===== BỘ LỌC DANH MỤC (STICKY MENU BAR) ===== */
.filter-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  padding: 14px 20px;
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--surface-nav);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  border-bottom: 1px solid var(--border-clay);
}

.filter-btn {
  appearance: none;
  padding: 9px 17px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border-clay);
  background: var(--surface-plaster);
  color: var(--ink-mulberry);
  font-weight: 600;
  font-size: 0.82rem;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition:
    transform 0.25s var(--ease-riad),
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease;
  will-change: transform;
}

.filter-btn:hover {
  color: var(--ink-fig);
  border-color: var(--saffron);
  background: #FFFFFF;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(43, 25, 46, 0.06);
}

.filter-btn:active {
  transform: translateY(0) scale(0.98);
}

.filter-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--bg-sand), 0 0 0 4px var(--saffron);
}

.filter-btn.active {
  color: var(--ink-cream);
  background: var(--ink-fig);
  border-color: var(--ink-fig);
  box-shadow: 0 6px 16px -4px rgba(43, 25, 46, 0.3);
}

.filter-btn.active:hover {
  background: var(--mint-jade);
  border-color: var(--mint-jade);
  color: var(--ink-cream);
}

/* ===== LƯỚI SẢN PHẨM (GRID 2 CỘT) ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
  padding: 38px 24px 76px;
  max-width: 1120px;
  margin: 0 auto;
}

.product-grid > p {
  color: var(--ink-mulberry) !important;
  font-weight: 600;
  background: var(--surface-plaster);
  border: 1px solid var(--border-clay);
  border-radius: var(--radius-lg);
}

/* ===== CARD MÓN UỐNG & BÁNH ===== */
.product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--surface-plaster);
  border: 1px solid var(--border-clay);
  border-radius: var(--radius-lg);
  padding: 9px;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition:
    transform 0.35s var(--ease-riad),
    border-color 0.25s ease,
    box-shadow 0.35s var(--ease-riad);
  will-change: transform;
}

.product-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-saffron);
  box-shadow: var(--shadow-card-hover);
}

.card-image {
  width: 100%;
  height: 222px;
  object-fit: cover;
  display: block;
  border-radius: 16px 16px 8px 8px;
  background-color: var(--bg-clay-tint);
  background-image: linear-gradient(110deg, #EADCD3 8%, #F7EFEA 18%, #EADCD3 33%);
  background-size: 200% 100%;
  animation: sandShimmer 1.8s linear infinite;
  transition: transform 0.55s var(--ease-riad), filter 0.35s ease;
  will-change: transform;
}

.product-card:hover .card-image {
  transform: scale(1.03);
  filter: saturate(1.06);
}

@keyframes sandShimmer {
  to {
    background-position-x: -200%;
  }
}

.card-body {
  position: relative;
  padding: 15px 10px 10px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.card-category-tag {
  align-self: flex-start;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--mint-dark);
  background: var(--surface-mint-tint);
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  margin-bottom: 9px;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-name {
  font-size: 1.04rem;
  font-weight: 700;
  line-height: 1.38;
  color: var(--ink-fig);
  margin-bottom: 8px;
  letter-spacing: -0.01em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: calc(1.04rem * 1.38 * 2);
  word-break: break-word;
}

.card-price {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  font-size: 1.12rem;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--saffron-hover);
  background: var(--saffron-soft);
  padding: 4px 11px;
  border-radius: var(--radius-sm);
  margin-bottom: 15px;
  font-variant-numeric: tabular-nums;
}

.card-btn {
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 11px 16px;
  border-radius: var(--radius-md);
  border: 1px solid var(--mint-jade);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.01em;
  text-decoration: none;
  color: var(--ink-cream);
  background: var(--mint-jade);
  cursor: pointer;
  white-space: nowrap;
  line-height: 1.2;
  transition:
    transform 0.25s var(--ease-riad),
    background-color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.25s ease;
  will-change: transform;
}

.card-btn:hover {
  background: var(--ink-fig);
  border-color: var(--ink-fig);
  color: var(--ink-cream);
  transform: translateY(-1px);
  box-shadow: 0 8px 18px -6px rgba(43, 25, 46, 0.34);
}

.card-btn:active {
  transform: translateY(0) scale(0.985);
}

.card-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--surface-plaster), 0 0 0 4px var(--mint-jade);
}

.card-btn img {
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #FFFFFF;
  padding: 1.5px;
  flex-shrink: 0;
}

/* ===== FOOTER ===== */
.footer {
  position: relative;
  text-align: center;
  padding: 46px 20px 104px;
  color: var(--ink-mulberry);
  font-size: 0.85rem;
  background: var(--surface-plaster);
  border-top: 1px solid var(--border-clay);
}

.footer::before {
  content: 'TIỆM CÀ PHÊ';
  display: block;
  margin-bottom: 10px;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.22em;
  color: var(--ink-fig);
}

.footer p {
  margin-bottom: 6px;
  color: var(--ink-mulberry);
  font-weight: 400;
}

.footer p:last-child {
  margin-top: 14px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--saffron-hover);
  background: var(--bg-sand);
  border: 1px solid var(--border-saffron);
  border-radius: var(--radius-pill);
}

/* ===== NÚT LIÊN HỆ ZALO (FAB) ===== */
.fab-zalo {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px 10px 10px;
  border-radius: var(--radius-pill);
  text-decoration: none;
  color: var(--ink-cream);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.01em;
  background: var(--ink-fig);
  border: 1.5px solid rgba(255, 255, 255, 0.25);
  box-shadow: var(--shadow-fab);
  z-index: 100;
  transition:
    transform 0.3s var(--ease-riad),
    background-color 0.25s ease,
    box-shadow 0.3s ease;
  will-change: transform;
}

.fab-zalo:hover {
  background: var(--saffron);
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 16px 32px -6px rgba(217, 130, 24, 0.44);
}

.fab-zalo:active {
  transform: translateY(0) scale(0.97);
}

.fab-zalo:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px var(--bg-sand), 0 0 0 5px var(--saffron);
}

.fab-zalo img {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #FFFFFF;
  padding: 2px;
  flex-shrink: 0;
}

.fab-zalo span {
  white-space: nowrap;
}

/* ===== REDUCED MOTION ===== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* ===== RESPONSIVE (TABLET & MOBILE) ===== */
@media (max-width: 900px) {
  .product-grid {
    gap: 18px;
    padding: 32px 18px 60px;
  }

  .card-image {
    height: 194px;
  }
}

@media (max-width: 768px) {
  .header {
    padding: 46px 16px 36px;
  }

  .header-content::before {
    font-size: 0.62rem;
    padding: 4px 12px;
    letter-spacing: 0.14em;
  }

  .filter-nav {
    gap: 6px;
    padding: 12px 10px;
  }

  .filter-btn {
    padding: 7px 13px;
    font-size: 0.77rem;
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    padding: 24px 14px 52px;
  }

  .product-card {
    padding: 7px;
    border-radius: 18px;
  }

  .card-image {
    height: 160px;
    border-radius: 13px 13px 6px 6px;
  }

  .card-body {
    padding: 12px 6px 6px;
  }

  .card-category-tag {
    font-size: 0.6rem;
    padding: 3px 8px;
    margin-bottom: 8px;
  }

  .card-name {
    font-size: 0.92rem;
    min-height: calc(0.92rem * 1.38 * 2);
    margin-bottom: 6px;
  }

  .card-price {
    font-size: 0.98rem;
    padding: 3px 9px;
    margin-bottom: 12px;
  }

  .card-btn {
    padding: 10px 10px;
    font-size: 0.78rem;
    gap: 6px;
    border-radius: 12px;
  }

  .footer {
    padding: 38px 16px 96px;
  }

  .fab-zalo {
    bottom: 16px;
    right: 16px;
    padding: 9px 15px 9px 9px;
    font-size: 0.8rem;
  }
}

@media (max-width: 400px) {
  .header {
    padding: 40px 12px 30px;
  }

  .product-grid {
    gap: 10px;
    padding: 20px 10px 48px;
  }

  .product-card {
    padding: 6px;
  }

  .card-image {
    height: 138px;
  }

  .card-body {
    padding: 10px 5px 5px;
  }

  .card-name {
    font-size: 0.84rem;
    min-height: calc(0.84rem * 1.38 * 2);
  }

  .card-price {
    font-size: 0.9rem;
    padding: 3px 8px;
  }

  .card-btn {
    font-size: 0.72rem;
    padding: 9px 8px;
    gap: 5px;
  }

  .fab-zalo {
    padding: 10px;
    border-radius: 50%;
  }

  .fab-zalo span {
    display: none;
  }
}

@media (max-width: 330px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}
