/* =========================================================
   TIỆM NHÀ SÓC NHÍM — CYBER-NOIR ARCADE
   Redesign visual v4. Structure / HUD / logic: untouched.
   Kèm fix: card-name clamp, card-btn overflow, tag ellipsis.
   ========================================================= */

/* ===== RESET & BASE ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

:root {
  /* Void & surfaces */
  --void: #05060a;
  --void-2: #0a0c14;
  --panel: #0d1018;
  --panel-2: #121622;
  --panel-hover: #161b2a;

  /* Neon palette */
  --lime: #c8ff2e;
  --pink: #ff2e88;
  --cyan: #00e5ff;
  --violet: #9d4dff;

  /* Text */
  --txt-1: #e8f0ff;
  --txt-2: #94a3c4;
  --txt-3: #556080;

  /* Lines */
  --line: #1a2036;
  --line-neon: rgba(200, 255, 46, 0.4);

  /* Shape */
  --chamfer: 12px; /* góc vát */

  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

body {
  background:
    /* Scanlines ngang rất mảnh */
    repeating-linear-gradient(
      0deg,
      transparent 0 3px,
      rgba(0, 229, 255, 0.018) 3px 4px
    ),
    /* Grid neon mờ */
    linear-gradient(rgba(200, 255, 46, 0.04) 1px, transparent 1px) 0 0 / 40px 40px,
    linear-gradient(90deg, rgba(200, 255, 46, 0.04) 1px, transparent 1px) 0 0 / 40px 40px,
    /* Vignette tím cyan hai góc */
    radial-gradient(900px 500px at 0% 0%, rgba(157, 77, 255, 0.14), transparent 60%),
    radial-gradient(900px 500px at 100% 100%, rgba(0, 229, 255, 0.10), transparent 60%),
    var(--void);
  color: var(--txt-1);
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-feature-settings: "kern", "ss01";
}

/* ===== HEADER ===== */
.header {
  position: relative;
  padding: 68px 20px 54px;
  text-align: center;
  background: var(--panel);
  border-bottom: 1px solid var(--line);
  overflow: hidden;
  isolation: isolate;
}

/* Corner brackets HUD — 4 góc */
.header::before,
.header::after {
  content: '';
  position: absolute;
  width: 28px;
  height: 28px;
  border-color: var(--lime);
  border-style: solid;
  z-index: 1;
  opacity: 0.7;
}

.header::before {
  top: 16px;
  left: 16px;
  border-width: 2px 0 0 2px;
}

.header::after {
  bottom: 16px;
  right: 16px;
  border-width: 0 2px 2px 0;
}

.header-content {
  position: relative;
  z-index: 2;
  max-width: 780px;
  margin: 0 auto;
}

/* Dòng "SYSTEM ONLINE" phía trên */
.header-content::before {
  content: '// SYSTEM ONLINE · NODE: SÓC-NHÍM';
  display: block;
  margin-bottom: 22px;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.28em;
  color: var(--lime);
  text-transform: uppercase;
  text-shadow: 0 0 12px rgba(200, 255, 46, 0.5);
}

/* Con trỏ blink giả lập terminal */
.header-content::after {
  content: '▊';
  display: inline-block;
  margin-left: 4px;
  color: var(--lime);
  font-size: 0.68rem;
  animation: blink 1.1s steps(1) infinite;
  vertical-align: 0.1em;
}

@keyframes blink {
  50% { opacity: 0; }
}

.shop-name {
  font-size: clamp(1.9rem, 5.6vw, 3.1rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: 0.01em;
  color: var(--txt-1);
  text-transform: uppercase;
  text-wrap: balance;
  position: relative;
  display: inline-block;
}

/* Chữ có viền neon + bóng mờ phía sau */
.shop-name::before {
  content: attr(data-text);
  position: absolute;
  inset: 0;
  color: var(--lime);
  filter: blur(14px);
  opacity: 0.35;
  z-index: -1;
  pointer-events: none;
}

.shop-slogan {
  margin-top: 20px;
  font-size: clamp(0.82rem, 2.3vw, 0.96rem);
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--txt-2);
}

/* Dấu // trước và sau slogan */
.shop-slogan::before { content: '// '; color: var(--cyan); }
.shop-slogan::after  { content: ' //'; color: var(--cyan); }

/* ===== BỘ LỌC DANH MỤC ===== */
.filter-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  padding: 16px 20px;
  margin: 0;
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(10, 12, 20, 0.88);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  border-bottom: 1px solid var(--line);
  box-shadow: 0 1px 0 rgba(200, 255, 46, 0.15);
}

.filter-btn {
  appearance: none;
  padding: 9px 16px;
  border-radius: 0;
  border: 1px solid var(--line);
  background: var(--panel);
  color: var(--txt-2);
  font-family: inherit;
  font-weight: 600;
  font-size: 0.82rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  cursor: pointer;
  position: relative;
  transition:
    color 0.25s var(--ease),
    border-color 0.25s var(--ease),
    background 0.25s var(--ease),
    box-shadow 0.25s var(--ease),
    transform 0.25s var(--ease);
  /* Góc vát */
  clip-path: polygon(
    0 0,
    calc(100% - 8px) 0,
    100% 8px,
    100% 100%,
    8px 100%,
    0 calc(100% - 8px)
  );
}

.filter-btn:hover {
  color: var(--txt-1);
  border-color: var(--line-neon);
  background: var(--panel-2);
  box-shadow: 0 0 16px rgba(200, 255, 46, 0.12);
}

.filter-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--lime);
}

.filter-btn.active {
  color: var(--void);
  background: var(--lime);
  border-color: var(--lime);
  box-shadow:
    0 0 22px rgba(200, 255, 46, 0.5),
    0 0 44px rgba(200, 255, 46, 0.15);
  transform: translateY(-1px);
}

/* ===== LƯỚI SẢN PHẨM ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
  padding: 44px 24px 72px;
  max-width: 1180px;
  margin: 0 auto;
}

.product-grid > p {
  color: var(--txt-3) !important;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 0.85rem;
}

/* ===== CARD SẢN PHẨM ===== */
.product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--panel);
  border: 1px solid var(--line);
  overflow: hidden;
  /* Góc vát */
  clip-path: polygon(
    0 0,
    calc(100% - 14px) 0,
    100% 14px,
    100% 100%,
    14px 100%,
    0 calc(100% - 14px)
  );
  transition:
    border-color 0.35s var(--ease),
    background 0.35s var(--ease),
    box-shadow 0.35s var(--ease),
    transform 0.35s var(--ease);
  will-change: transform;
}

/* Corner brackets HUD — 2 góc đối diện */
.product-card::before {
  content: '';
  position: absolute;
  top: 8px;
  left: 8px;
  width: 20px;
  height: 20px;
  border-top: 2px solid var(--lime);
  border-left: 2px solid var(--lime);
  z-index: 3;
  opacity: 0;
  transform: translate(-4px, -4px);
  transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  pointer-events: none;
}

.product-card::after {
  content: '';
  position: absolute;
  bottom: 8px;
  right: 8px;
  width: 20px;
  height: 20px;
  border-bottom: 2px solid var(--pink);
  border-right: 2px solid var(--pink);
  z-index: 3;
  opacity: 0;
  transform: translate(4px, 4px);
  transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
  pointer-events: none;
}

.product-card:hover {
  border-color: var(--line-neon);
  background: var(--panel-hover);
  transform: translateY(-4px);
  box-shadow:
    0 0 0 1px rgba(200, 255, 46, 0.25),
    0 0 32px -8px rgba(200, 255, 46, 0.35),
    0 20px 44px -20px rgba(0, 0, 0, 0.8);
}

.product-card:hover::before,
.product-card:hover::after {
  opacity: 1;
  transform: translate(0, 0);
}

/* Ảnh */
.card-image {
  width: 100%;
  height: 200px;
  object-fit: cover;
  display: block;
  background: var(--void-2);
  border-bottom: 1px solid var(--line);
  filter: grayscale(35%) contrast(1.08) brightness(0.92) hue-rotate(160deg);
  transition: filter 0.5s var(--ease), transform 0.6s var(--ease);
  /* Loading shimmer neon */
  background-image: linear-gradient(
    110deg,
    var(--void-2) 8%,
    #151b2b 18%,
    var(--void-2) 33%
  );
  background-size: 200% 100%;
  animation: shimmerNeon 1.9s linear infinite;
}

.product-card:hover .card-image {
  filter: grayscale(0%) contrast(1.04) brightness(1) hue-rotate(0deg);
  transform: scale(1.04);
}

@keyframes shimmerNeon {
  to { background-position-x: -200%; }
}

/* Body */
.card-body {
  position: relative;
  padding: 16px 18px 20px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  background: var(--panel);
  min-height: 0;
  justify-content: flex-start;
}

/* Badge danh mục — tag terminal-style */
.card-category-tag {
  align-self: flex-start;
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--pink);
  background: rgba(255, 46, 136, 0.08);
  border: 1px solid rgba(255, 46, 136, 0.35);
  padding: 3px 8px;
  border-radius: 2px;
  margin-bottom: 12px;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 0 10px rgba(255, 46, 136, 0.5);
}

/* Chấm xanh nhỏ trước tag */
.card-category-tag::before {
  content: '● ';
  color: var(--cyan);
  font-size: 0.7em;
  vertical-align: 0.15em;
  margin-right: 4px;
  text-shadow: 0 0 8px var(--cyan);
}

.card-name {
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.4;
  color: var(--txt-1);
  margin-bottom: 12px;
  letter-spacing: 0.01em;
  /* Fix: giới hạn 2 dòng + khóa chiều cao để card đều */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: calc(1rem * 1.4 * 2);
  word-break: break-word;
}

/* Giá — terminal price style */
.card-price {
  display: inline-block;
  align-self: flex-start;
  font-size: 1.18rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  color: var(--lime);
  background: rgba(200, 255, 46, 0.06);
  border: 1px solid rgba(200, 255, 46, 0.25);
  padding: 4px 10px;
  border-radius: 2px;
  margin-bottom: 18px;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 14px rgba(200, 255, 46, 0.45);
  position: relative;
}

/* Gạch chéo nhỏ góc giá */
.card-price::before {
  content: '¥';
  color: var(--cyan);
  margin-right: 4px;
  font-size: 0.85em;
  opacity: 0.7;
}

/* ===== NÚT LIÊN HỆ ===== */
.card-btn {
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 14px;
  border-radius: 0;
  border: 1px solid var(--lime);
  font-weight: 700;
  font-size: 0.84rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--lime);
  background: transparent;
  transition:
    background 0.3s var(--ease),
    color 0.3s var(--ease),
    box-shadow 0.3s var(--ease),
    transform 0.3s var(--ease);
  cursor: pointer;
  position: relative;
  overflow: visible;
  min-width: 0;
  white-space: nowrap;
  line-height: 1.2;
  /* Góc vát nhỏ cho nút */
  clip-path: polygon(
    0 0,
    calc(100% - 6px) 0,
    100% 6px,
    100% 100%,
    6px 100%,
    0 calc(100% - 6px)
  );
}

.card-btn:hover {
  background: var(--lime);
  color: var(--void);
  box-shadow:
    0 0 20px rgba(200, 255, 46, 0.55),
    0 0 40px rgba(200, 255, 46, 0.2);
  transform: translateY(-2px);
}

.card-btn:active {
  transform: translateY(0);
}

.card-btn:focus-visible {
  outline: none;
  box-shadow:
    0 0 0 2px var(--void),
    0 0 0 4px var(--lime);
}

.card-btn img {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #fff;
  padding: 1px;
  flex-shrink: 0;
  transition: filter 0.3s var(--ease);
}

/* ===== FOOTER ===== */
.footer {
  position: relative;
  text-align: center;
  padding: 48px 20px 116px;
  margin-top: 0;
  color: var(--txt-2);
  font-size: 0.84rem;
  background: var(--panel);
  border-top: 1px solid var(--line);
  letter-spacing: 0.04em;
}

/* Dòng "// SYSTEM INFO" phía trên */
.footer::before {
  content: '// SYSTEM INFO';
  display: block;
  margin-bottom: 18px;
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.28em;
  color: var(--cyan);
  text-transform: uppercase;
  text-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
}

.footer p {
  margin-bottom: 8px;
  color: var(--txt-2);
}

.footer p:last-child {
  color: var(--lime);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 10px rgba(200, 255, 46, 0.4);
}

/* ===== FAB ZALO ===== */
.fab-zalo {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 18px 12px 14px;
  border-radius: 0;
  text-decoration: none;
  color: var(--void);
  font-weight: 700;
  font-size: 0.82rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: var(--lime);
  border: 1px solid var(--lime);
  box-shadow:
    0 0 22px rgba(200, 255, 46, 0.5),
    0 0 44px rgba(200, 255, 46, 0.18);
  z-index: 100;
  transition:
    background 0.3s var(--ease),
    color 0.3s var(--ease),
    box-shadow 0.3s var(--ease),
    transform 0.3s var(--ease);
  /* Góc vát */
  clip-path: polygon(
    0 0,
    calc(100% - 10px) 0,
    100% 10px,
    100% 100%,
    10px 100%,
    0 calc(100% - 10px)
  );
}

.fab-zalo:hover {
  background: var(--pink);
  border-color: var(--pink);
  color: #fff;
  transform: translateY(-3px);
  box-shadow:
    0 0 24px rgba(255, 46, 136, 0.6),
    0 0 48px rgba(255, 46, 136, 0.25);
}

.fab-zalo:active {
  transform: translateY(0);
}

.fab-zalo:focus-visible {
  outline: none;
  box-shadow:
    0 0 0 2px var(--void),
    0 0 0 4px var(--lime);
}

.fab-zalo img {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #fff;
  padding: 2px;
  flex-shrink: 0;
}

.fab-zalo span {
  white-space: nowrap;
}

/* ===== REDUCED MOTION ===== */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
  .product-grid {
    gap: 18px;
    padding: 32px 20px 60px;
  }

  .card-image {
    height: 175px;
  }
}

@media (max-width: 768px) {
  .header {
    padding: 52px 16px 42px;
  }

  .header::before,
  .header::after {
    width: 22px;
    height: 22px;
  }

  .header-content::before {
    font-size: 0.6rem;
    letter-spacing: 0.22em;
  }

  .filter-nav {
    gap: 6px;
    padding: 12px 10px;
  }

  .filter-btn {
    padding: 8px 12px;
    font-size: 0.74rem;
  }

  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding: 26px 14px 54px;
  }

  .card-image {
    height: 148px;
  }

  .card-body {
    padding: 12px 12px 14px;
  }

  .card-name {
    font-size: 0.9rem;
    min-height: calc(0.9rem * 1.4 * 2);
    margin-bottom: 10px;
  }

  .card-price {
    font-size: 1rem;
    padding: 3px 8px;
    margin-bottom: 12px;
  }

  .card-btn {
    padding: 10px 10px;
    font-size: 0.74rem;
    gap: 6px;
    letter-spacing: 0.04em;
  }

  .fab-zalo {
    bottom: 16px;
    right: 16px;
    padding: 10px 15px 10px 11px;
    font-size: 0.76rem;
  }

  .footer {
    padding: 36px 16px 100px;
  }
}

@media (max-width: 400px) {
  .header {
    padding: 44px 12px 32px;
  }

  .card-image {
    height: 130px;
  }

  .card-category-tag {
    font-size: 0.56rem;
    padding: 2px 6px;
    letter-spacing: 0.12em;
  }

  .card-name {
    font-size: 0.82rem;
    min-height: calc(0.82rem * 1.4 * 2);
  }

  .card-price {
    font-size: 0.9rem;
    padding: 3px 6px;
  }

  .card-btn {
    font-size: 0.68rem;
    padding: 9px 6px;
    gap: 4px;
    white-space: nowrap;
    overflow: visible;
    letter-spacing: 0.02em;
  }

  /* FAB thu gọn còn icon */
  .fab-zalo {
    padding: 12px;
    border-radius: 50%;
    clip-path: none;
  }

  .fab-zalo span {
    display: none;
  }
}

@media (max-width: 340px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}