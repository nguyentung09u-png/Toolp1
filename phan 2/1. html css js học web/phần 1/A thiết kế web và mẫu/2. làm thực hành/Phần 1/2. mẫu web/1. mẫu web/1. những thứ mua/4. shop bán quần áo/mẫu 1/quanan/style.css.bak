/* =========================================================
   TIỆM QUẦN ÁO — Y2K CHROME BUBBLE
   Redesign visual theo menu quần áo (xanh/đen)
   ========================================================= */

/* ===== RESET & BASE ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

:root {
  /* Nền tối xanh */
  --bg-1: #0a1628;
  --bg-2: #0f2137;
  --bg-3: #0a1628;
  --surface: #122a44;
  --surface-2: #1a3a5c;

  /* Accent xanh neon */
  --hot-pink: #00d4ff;
  --hot-pink-deep: #00a3cc;
  --baby-blue: #00d4ff;
  --baby-blue-deep: #00a3cc;
  --lavender: #66e0ff;
  --lavender-deep: #33ccff;
  --mint: #00ffcc;
  --butter: #ffd700;
  --peach: #ff9500;

  /* Text */
  --ink-1: #ffffff;
  --ink-2: #b0d4f1;
  --ink-3: #6b9bc3;

  /* Chrome gradient */
  --chrome: linear-gradient(135deg, #00d4ff 0%, #66e0ff 35%, #00ffcc 65%, #ffd700 100%);

  /* Shape */
  --radius-sm: 12px;
  --radius-md: 20px;
  --radius-lg: 28px;
  --radius-xl: 36px;
  --radius-pill: 999px;

  --ease: cubic-bezier(0.34, 1.56, 0.64, 1);
}

body {
  background:
    radial-gradient(600px 400px at 10% 5%, rgba(0, 212, 255, 0.12), transparent 65%),
    radial-gradient(700px 500px at 90% 15%, rgba(102, 224, 255, 0.15), transparent 65%),
    radial-gradient(650px 450px at 50% 100%, rgba(0, 255, 204, 0.10), transparent 65%),
    radial-gradient(500px 380px at 15% 90%, rgba(255, 215, 0, 0.08), transparent 65%),
    linear-gradient(160deg, var(--bg-1) 0%, var(--bg-2) 50%, var(--bg-3) 100%);
  background-attachment: fixed;
  color: var(--ink-1);
  line-height: 1.6;
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-feature-settings: "kern", "ss01";
}

/* ===== HEADER ===== */
.header {
  position: relative;
  padding: 72px 20px 56px;
  text-align: center;
  background: linear-gradient(180deg, rgba(18, 42, 68, 0.8) 0%, rgba(10, 22, 40, 0.4) 100%);
  border-bottom: 2px solid rgba(0, 212, 255, 0.3);
  overflow: hidden;
  isolation: isolate;
}

.header::before {
  content: '';
  position: absolute;
  width: 180px;
  height: 180px;
  top: -60px;
  left: 8%;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.6), rgba(0, 212, 255, 0.4) 50%, transparent 75%);
  filter: blur(2px);
  z-index: 0;
  animation: floatBubble 8s ease-in-out infinite;
  pointer-events: none;
}

.header::after {
  content: '';
  position: absolute;
  width: 120px;
  height: 120px;
  top: 30%;
  right: 6%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.7), rgba(0, 255, 204, 0.4) 55%, transparent 80%);
  filter: blur(1px);
  z-index: 0;
  animation: floatBubble 10s ease-in-out infinite reverse;
  pointer-events: none;
}

@keyframes floatBubble {
  0%, 100% { transform: translateY(0) scale(1); }
  50%      { transform: translateY(-18px) scale(1.05); }
}

.header-content {
  position: relative;
  z-index: 1;
  max-width: 780px;
  margin: 0 auto;
}

.header-content::before {
  content: '✦ THỜI TRANG CHẤT ✦';
  display: inline-block;
  margin-bottom: 20px;
  padding: 8px 20px;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  color: #0a1628;
  background: linear-gradient(135deg, #00d4ff, #66e0ff);
  border: 2px solid #fff;
  border-radius: var(--radius-pill);
  box-shadow: 0 4px 0 rgba(255, 255, 255, 0.9), 0 8px 20px -4px rgba(0, 212, 255, 0.5);
  transform: rotate(-3deg);
  animation: stickerWobble 4s ease-in-out infinite;
}

@keyframes stickerWobble {
  0%, 100% { transform: rotate(-3deg); }
  50%      { transform: rotate(2deg); }
}

.shop-name {
  font-size: clamp(2rem, 5.8vw, 3.2rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: transparent;
  background: var(--chrome);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  text-wrap: balance;
  text-shadow: 0 2px 0 rgba(0, 0, 0, 0.3), 0 4px 0 rgba(0, 212, 255, 0.15), 0 8px 20px rgba(0, 212, 255, 0.4);
  filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.5));
  animation: chromeShift 6s ease-in-out infinite;
  position: relative;
}

@keyframes chromeShift {
  0%, 100% { background-position: 0% 50%; }
  50%      { background-position: 100% 50%; }
}

.shop-name::before {
  content: '✧';
  position: absolute;
  left: -0.5em;
  top: 0.05em;
  font-size: 0.5em;
  color: var(--butter);
  -webkit-text-fill-color: var(--butter);
  text-shadow: 0 0 8px rgba(255, 215, 0, 0.9);
  animation: sparkle 2s ease-in-out infinite;
}

.shop-name::after {
  content: '✧';
  position: absolute;
  right: -0.5em;
  top: 0.05em;
  font-size: 0.5em;
  color: var(--butter);
  -webkit-text-fill-color: var(--butter);
  text-shadow: 0 0 8px rgba(255, 215, 0, 0.9);
  animation: sparkle 2s ease-in-out infinite 1s;
}

@keyframes sparkle {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.7; }
  50%      { transform: scale(1.3) rotate(180deg); opacity: 1; }
}

.shop-slogan {
  margin-top: 18px;
  font-size: clamp(0.88rem, 2.4vw, 1rem);
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--ink-2);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  background: rgba(18, 42, 68, 0.7);
  border: 1.5px solid rgba(0, 212, 255, 0.3);
  border-radius: var(--radius-pill);
  box-shadow: 0 4px 12px -4px rgba(0, 212, 255, 0.5);
}

.shop-slogan::before { content: '👕'; }
.shop-slogan::after  { content: '✨'; }

/* ===== BỘ LỌC DANH MỤC ===== */
.filter-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  padding: 18px 20px;
  margin: 0;
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(10, 22, 40, 0.85);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  border-bottom: 1.5px solid rgba(0, 212, 255, 0.3);
  box-shadow: 0 4px 16px -8px rgba(0, 212, 255, 0.3);
}

.filter-btn {
  appearance: none;
  padding: 10px 20px;
  border-radius: var(--radius-pill);
  border: 2px solid rgba(0, 212, 255, 0.3);
  background: rgba(18, 42, 68, 0.8);
  color: var(--ink-2);
  font-family: inherit;
  font-weight: 700;
  font-size: 0.84rem;
  letter-spacing: 0.01em;
  cursor: pointer;
  position: relative;
  transition: transform 0.35s var(--ease), background 0.3s ease, color 0.3s ease, box-shadow 0.35s ease;
  box-shadow: 0 2px 0 rgba(0, 212, 255, 0.2), 0 4px 12px -2px rgba(0, 212, 255, 0.15);
  will-change: transform;
}

.filter-btn:hover {
  background: var(--surface-2);
  color: var(--hot-pink);
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 4px 0 rgba(0, 212, 255, 0.3), 0 8px 20px -4px rgba(0, 212, 255, 0.4);
}

.filter-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px #0a1628, 0 0 0 6px var(--hot-pink), 0 4px 12px -2px rgba(0, 212, 255, 0.4);
}

.filter-btn.active {
  color: #0a1628;
  background: linear-gradient(135deg, var(--hot-pink) 0%, var(--lavender-deep) 100%);
  border-color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 4px 0 rgba(0, 163, 204, 0.5), 0 8px 24px -4px rgba(0, 212, 255, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

/* ===== LƯỚI SẢN PHẨM ===== */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  padding: 44px 24px 72px;
  max-width: 1160px;
  margin: 0 auto;
}

.product-grid > p {
  color: var(--ink-3) !important;
  font-weight: 600;
  letter-spacing: 0.03em;
}

/* ===== CARD SẢN PHẨM ===== */
.product-card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: rgba(18, 42, 68, 0.9);
  border: 2px solid rgba(0, 212, 255, 0.3);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 6px 0 rgba(0, 163, 204, 0.3), 0 14px 28px -10px rgba(0, 212, 255, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transition: transform 0.4s var(--ease), box-shadow 0.4s ease, background 0.3s ease;
  will-change: transform;
}

.product-card::before {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: inherit;
  background: linear-gradient(135deg, transparent 0%, transparent 40%, rgba(0, 212, 255, 0.5) 50%, transparent 60%, transparent 100%);
  background-size: 200% 200%;
  background-position: 0% 0%;
  pointer-events: none;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.product-card:hover {
  transform: translateY(-6px);
  background: rgba(26, 58, 92, 0.95);
  box-shadow: 0 8px 0 rgba(0, 212, 255, 0.4), 0 20px 40px -12px rgba(0, 212, 255, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.15);
}

.product-card:hover::before {
  opacity: 1;
  animation: chromeSheen 1.6s ease-in-out;
}

@keyframes chromeSheen {
  0%   { background-position: 0% 0%; }
  100% { background-position: 200% 200%; }
}

.card-image {
  width: 100%;
  height: 200px;
  object-fit: cover;
  display: block;
  background: linear-gradient(135deg, var(--bg-1), var(--bg-2));
  filter: saturate(1.15) contrast(1.02);
  transition: filter 0.4s ease, transform 0.6s var(--ease);
  position: relative;
  z-index: 0;
  background-image: linear-gradient(110deg, #0a1628 8%, #122a44 18%, #1a3a5c 33%);
  background-size: 200% 100%;
  animation: shimmerBubble 2s linear infinite;
}

.product-card:hover .card-image {
  filter: saturate(1.25) contrast(1.04);
  transform: scale(1.04);
}

@keyframes shimmerBubble {
  to { background-position-x: -200%; }
}

.card-body {
  position: relative;
  padding: 16px 18px 20px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  background: rgba(18, 42, 68, 0.92);
  min-height: 0;
  justify-content: flex-start;
  z-index: 2;
}

.card-category-tag {
  align-self: flex-start;
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #0a1628;
  background: linear-gradient(135deg, var(--butter), var(--peach));
  padding: 4px 12px;
  border-radius: var(--radius-pill);
  border: 2px solid rgba(255, 255, 255, 0.8);
  margin-bottom: 12px;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 2px 0 rgba(255, 149, 0, 0.5), 0 4px 10px -2px rgba(255, 149, 0, 0.4);
}

.card-name {
  font-size: 1.04rem;
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink-1);
  margin-bottom: 12px;
  letter-spacing: -0.005em;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: calc(1.04rem * 1.4 * 2);
  word-break: break-word;
}

.card-price {
  display: inline-block;
  align-self: flex-start;
  font-size: 1.14rem;
  font-weight: 800;
  letter-spacing: -0.005em;
  color: var(--hot-pink);
  background: linear-gradient(135deg, #122a44, #1a3a5c);
  border: 2px solid rgba(0, 212, 255, 0.4);
  padding: 4px 14px;
  border-radius: var(--radius-pill);
  margin-bottom: 18px;
  font-variant-numeric: tabular-nums;
  box-shadow: 0 3px 0 rgba(0, 212, 255, 0.25), 0 6px 14px -4px rgba(0, 212, 255, 0.3);
  position: relative;
}

.card-price::before {
  content: '🛒 ';
  color: var(--hot-pink);
  font-size: 0.85em;
  font-weight: 400;
}

.card-btn {
  margin-top: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 16px;
  border-radius: var(--radius-pill);
  border: 2px solid rgba(255, 255, 255, 0.8);
  font-weight: 800;
  font-size: 0.86rem;
  letter-spacing: 0.01em;
  text-decoration: none;
  color: #0a1628;
  background: linear-gradient(135deg, var(--hot-pink) 0%, var(--lavender-deep) 100%);
  transition: transform 0.35s var(--ease), box-shadow 0.35s ease, filter 0.3s ease;
  cursor: pointer;
  position: relative;
  overflow: visible;
  min-width: 0;
  white-space: nowrap;
  line-height: 1.2;
  box-shadow: 0 4px 0 rgba(0, 163, 204, 0.6), 0 8px 20px -4px rgba(0, 212, 255, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.card-btn:hover {
  transform: translateY(-3px);
  filter: brightness(1.05) saturate(1.1);
  box-shadow: 0 6px 0 rgba(0, 163, 204, 0.7), 0 14px 28px -4px rgba(0, 212, 255, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.6);
}

.card-btn:active {
  transform: translateY(1px);
  box-shadow: 0 2px 0 rgba(0, 163, 204, 0.6), 0 4px 10px -4px rgba(0, 212, 255, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.card-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px #0a1628, 0 0 0 6px var(--hot-pink), 0 4px 0 rgba(0, 163, 204, 0.6);
}

.card-btn img {
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #fff;
  padding: 1px;
  flex-shrink: 0;
}

/* ===== FOOTER ===== */
.footer {
  position: relative;
  text-align: center;
  padding: 52px 20px 116px;
  margin-top: 0;
  color: var(--ink-2);
  font-size: 0.86rem;
  background: rgba(10, 22, 40, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 2px solid rgba(0, 212, 255, 0.3);
  letter-spacing: 0.01em;
  overflow: hidden;
}

.footer::before {
  content: '';
  position: absolute;
  width: 90px;
  height: 90px;
  bottom: -30px;
  left: 10%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.6), rgba(0, 212, 255, 0.3) 60%, transparent 80%);
  pointer-events: none;
}

.footer::after {
  content: '🎀 TIỆM QUẦN ÁO 🎀';
  display: block;
  margin-bottom: 20px;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.24em;
  color: var(--hot-pink);
}

.footer p {
  margin-bottom: 8px;
  color: var(--ink-2);
  font-weight: 500;
}

.footer p:last-child {
  color: var(--hot-pink);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  margin-top: 12px;
  display: inline-block;
  padding: 8px 20px;
  background: #122a44;
  border: 2px solid rgba(0, 212, 255, 0.4);
  border-radius: var(--radius-pill);
  box-shadow: 0 3px 0 rgba(0, 212, 255, 0.3), 0 6px 14px -4px rgba(0, 212, 255, 0.3);
}

/* ===== FAB ZALO ===== */
.fab-zalo {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 20px 12px 12px;
  border-radius: var(--radius-pill);
  text-decoration: none;
  color: #0a1628;
  font-weight: 800;
  font-size: 0.86rem;
  letter-spacing: 0.01em;
  background: linear-gradient(135deg, var(--hot-pink) 0%, var(--lavender-deep) 100%);
  border: 2px solid #fff;
  box-shadow: 0 4px 0 rgba(0, 163, 204, 0.6), 0 10px 24px -6px rgba(0, 212, 255, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  z-index: 100;
  transition: transform 0.35s var(--ease), box-shadow 0.35s ease, filter 0.3s ease;
  animation: fabFloat 3s ease-in-out infinite;
}

@keyframes fabFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-4px); }
}

.fab-zalo:hover {
  transform: translateY(-4px) scale(1.04);
  filter: brightness(1.06);
  box-shadow: 0 6px 0 rgba(0, 163, 204, 0.7), 0 16px 32px -6px rgba(0, 212, 255, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.6);
  animation-play-state: paused;
}

.fab-zalo:active {
  transform: translateY(0) scale(0.98);
}

.fab-zalo:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px #0a1628, 0 0 0 6px var(--hot-pink), 0 4px 0 rgba(0, 163, 204, 0.6);
}

.fab-zalo img {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #fff;
  padding: 2px;
  flex-shrink: 0;
}

.fab-zalo span {
  white-space: nowrap;
}

/* ===== REDUCED MOTION ===== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
  .product-grid { gap: 20px; padding: 34px 20px 60px; }
  .card-image { height: 175px; }
}

@media (max-width: 768px) {
  .header { padding: 54px 16px 44px; }
  .header::before { width: 130px; height: 130px; }
  .header::after { width: 90px; height: 90px; }
  .header-content::before { font-size: 0.64rem; padding: 6px 14px; letter-spacing: 0.14em; }
  .filter-nav { gap: 8px; padding: 14px 10px; }
  .filter-btn { padding: 8px 14px; font-size: 0.76rem; }
  .product-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; padding: 26px 14px 54px; }
  .card-image { height: 148px; }
  .card-body { padding: 13px 13px 16px; }
  .card-name { font-size: 0.92rem; min-height: calc(0.92rem * 1.4 * 2); margin-bottom: 10px; }
  .card-price { font-size: 1rem; padding: 3px 10px; margin-bottom: 14px; }
  .card-btn { padding: 10px 12px; font-size: 0.76rem; gap: 6px; }
  .fab-zalo { bottom: 16px; right: 16px; padding: 10px 16px 10px 10px; font-size: 0.8rem; }
  .footer { padding: 38px 16px 100px; }
}

@media (max-width: 400px) {
  .header { padding: 46px 12px 34px; }
  .card-image { height: 130px; }
  .card-category-tag { font-size: 0.58rem; padding: 3px 9px; letter-spacing: 0.1em; }
  .card-name { font-size: 0.84rem; min-height: calc(0.84rem * 1.4 * 2); }
  .card-price { font-size: 0.9rem; padding: 3px 9px; }
  .card-btn { font-size: 0.7rem; padding: 9px 8px; gap: 4px; white-space: nowrap; overflow: visible; }
  .fab-zalo { padding: 13px; border-radius: 50%; }
  .fab-zalo span { display: none; }
}

@media (max-width: 340px) {
  .product-grid { grid-template-columns: 1fr; }
}