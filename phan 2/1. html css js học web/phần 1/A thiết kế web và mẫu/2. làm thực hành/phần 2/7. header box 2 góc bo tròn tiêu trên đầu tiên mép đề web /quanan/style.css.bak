/* --- Cài đặt chung --- */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background-color: #f8f1e7; /* Màu nền be nhạt */
  color: #333;
  padding-bottom: 80px; /* Chừa chỗ cho nút Zalo */
}

/* =========================================================
   HEADER BOX — BO TRÒN 2 GÓC DƯỚI (thiết kế nâng cấp)
   ========================================================= */
.header {
  text-align: center;   /* ← dòng này căn giữa chữ theo chiều ngang */
  padding: 20px 15px 25px;   /* ↓ giảm từ 40px 20px 50px */
  margin-bottom: 18px;       /* ↓ giảm từ 25px */
  border-bottom-left-radius: 20px;
  border-bottom-right-radius: 20px;
  box-shadow: 0 4px 12px rgba(165, 42, 42, 0.25);  /* ↓ nhẹ hơn */
}
/* Vệt sáng mờ trang trí phía trên phải */
.header::before {
  content: "";
  position: absolute;
  top: -60px;
  right: -40px;
  width: 180px;
  height: 180px;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 50%;
  pointer-events: none;
}

/* Vệt sáng mờ trang trí phía dưới trái */
.header::after {
  content: "";
  position: absolute;
  bottom: -80px;
  left: -50px;
  width: 200px;
  height: 200px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  pointer-events: none;
}

/* Nội dung nằm trên các vệt sáng */
.header-content {
  position: relative;
  z-index: 2;
}

.header-emoji {
  font-size: 26px;    /* ↓ từ 40px */
  margin-bottom: 4px; /* ↓ từ 10px */
}

.header h1 {
  font-size: 20px;    /* ↓ từ 26px */
  margin-bottom: 4px; /* ↓ từ 10px */
}

.header p {
  display: none;   /* ẩn dòng "Ngon - Nóng - Hấp dẫn..." */
}/* --- Grid Container --- */
.menu-container {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 2 cột trên điện thoại */
  gap: 15px;
  padding: 0 15px;
  max-width: 1000px;
  margin: 0 auto;
}

/* --- Card Món Ăn --- */
.menu-card {
  position: relative;
  background-color: #fff8e1; /* Nền vàng nhạt */
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  isolation: isolate;
}

/* --- Hiệu ứng ánh sáng lướt qua toàn bộ bề mặt card --- */
.menu-card::after {
  content: "";
  position: absolute;
  top: 0;
  left: -150%;
  width: 70%;
  height: 100%;
  background: linear-gradient(
    115deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 235, 170, 0.35) 35%,
    rgba(255, 255, 255, 0.9) 50%,
    rgba(255, 235, 170, 0.35) 65%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: skewX(-25deg);
  pointer-events: none;
  z-index: 99;
  animation: card-shine 3.5s ease-in-out infinite;
}

@keyframes card-shine {
  0% { left: -150%; }
  45%, 100% { left: 160%; }
}

/* --- Hình ảnh món ăn --- */
.card-img {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  background-color: #f0f0f0;
}

/* --- Card Body --- */
.card-body {
  padding: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-grow: 1;
}

/* --- Phần Header của Card --- */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  min-height: 20px;
}

.ma-mon {
  font-size: 12px;
  font-weight: bold;
  color: #888;
  background-color: #f0f0f0;
  padding: 2px 6px;
  border-radius: 4px;
}

.badge {
  font-size: 10px;
  font-weight: bold;
  color: white;
  background-color: #ff9800;
  padding: 3px 8px;
  border-radius: 12px;
  text-transform: uppercase;
}

/* --- Tên và Giá món --- */
.menu-card h3 {
  font-size: 16px;
  color: #a52a2a;
  margin-bottom: 6px;
  line-height: 1.3;
}

.menu-card .price {
  font-weight: bold;
  color: #d32f2f;
  font-size: 15px;
  margin-bottom: 12px;
}

/* --- Nút liên hệ --- */
.menu-card .btn-contact {
  display: block;
  text-align: center;
  background-color: #0068ff;
  color: white;
  padding: 10px;
  border-radius: 6px;
  text-decoration: none;
  font-size: 13px;
  font-weight: bold;
  margin-top: auto;
}

.menu-card .btn-contact:hover {
  background-color: #0052cc;
}

/* --- Nút Zalo Nổi --- */
.zalo-btn {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background-color: #0068ff;
  color: white;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 15px;
  border-radius: 30px;
  text-decoration: none;
  box-shadow: 0 4px 12px rgba(0, 104, 255, 0.4);
  z-index: 100;
}

.zalo-btn img {
  width: 24px;
  height: 24px;
  background: white;
  border-radius: 50%;
  padding: 2px;
}

.zalo-btn span { font-size: 14px; font-weight: bold; }

/* --- Responsive (Tablet) --- */
@media (min-width: 768px) {
  .header { padding: 55px 20px 65px; }
  .header h1 { font-size: 34px; }
  .header p { font-size: 16px; }

  .menu-container {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
}

/* --- Responsive (Desktop) --- */
@media (min-width: 1024px) {
  .menu-container {
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
  }
}